# PostgreSQL Connection Settings (Zero-Cost Local or Free Tier)
# Never commit .env with real credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zomato_analytics
DB_USER=postgres
DB_PASSWORD=change_me_locally

# Optional full SQLAlchemy URL override:
# DATABASE_URL=postgresql+psycopg://postgres:change_me_locally@localhost:5432/zomato_analytics

# Pipeline Paths (Existing CSV Baseline — No Web Scraping)
PROJECT_ENV=development
RAW_CSV_PATH=data\raw\enhanced_zomato_dataset_clean.csv
PROCESSED_DIR=data\processed
QUARANTINE_DIR=data\quarantine
LOG_DIR=logs
LOG_LEVEL=INFO
